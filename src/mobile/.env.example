# Copy to .env and adjust. 10.0.2.2 is the host machine as seen from the Android emulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Set to "off" to hide every dev-only tool (seed, reset, test steps, test trades) and the
# dev warning toasts, e.g. to record the demo. Restart Metro with `npx expo start --clear`.
# EXPO_PUBLIC_DEV_TOOLS=off
